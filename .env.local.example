# ─── BASE DE DATOS ─────────────────────────────────────────────────────────────
# Obtené tu URL en https://supabase.com (free tier disponible)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://..."

# ─── SEGURIDAD JWT ──────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens. Usá una cadena larga y aleatoria.
# Generá una en: https://generate-secret.vercel.app/64
JWT_SECRET="cambia-esto-por-una-clave-secreta-muy-larga"

# ─── EMAIL (SMTP) ───────────────────────────────────────────────────────────────
# Para Gmail: usá una "Contraseña de Aplicación" (no tu contraseña normal)
# Ve a: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="tu@gmail.com"

# Para Outlook/Hotmail:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"

# ─── URL DE LA APP ──────────────────────────────────────────────────────────────
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── ANTHROPIC (ya existente) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── WEBHOOK (opcional, para pagos) ─────────────────────────────────────────────
# Clave secreta para validar webhooks del procesador de pagos
WEBHOOK_SECRET="clave-secreta-webhook"
